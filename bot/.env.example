# ── Telegram (optional but recommended for push notifications) ────────────────
# Create a bot via @BotFather on Telegram to get a token.
TELEGRAM_BOT_TOKEN=

# If the auto-registration via /start doesn't work, paste your chat ID here.
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_USER_CHAT_ID=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── OpenAI Realtime voice (optional) ─────────────────────────────────────────
# Leave blank to keep the existing iOS speech/Kokoro phone-call path.
# Store the key only in bot/.env (which is gitignored); never put it in the app.
OPENAI_API_KEY=

# Optional Realtime overrides. Defaults follow the current Realtime voice path.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
